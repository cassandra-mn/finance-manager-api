APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Comma-separated list of origins allowed to call this API (CORS), or "*" to
# allow any origin. Restrict this to your real frontend URL(s) once they're
# stable, e.g. ALLOWED_ORIGINS=https://myapp.example.com,http://localhost:3000
ALLOWED_ORIGINS=*

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services >
# Credentials > Create OAuth client ID > Web application). Must match the
# VITE_GOOGLE_CLIENT_ID used by the frontend — it's the token audience this
# API checks Google ID tokens against.
GOOGLE_CLIENT_ID=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=finance_manager
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

FINANCE_RECURRENCES_GENERATION_DAYS=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Credenciais do agregador Pluggy (https://dashboard.pluggy.ai), usadas para
# a integração de Open Finance (conectar contas bancárias e importar
# transações automaticamente). PLUGGY_WEBHOOK_SECRET é o segredo enviado como
# query string na URL de webhook cadastrada no dashboard da Pluggy
# (ex.: https://sua-api/api/v1/open-finance/webhook?token=<PLUGGY_WEBHOOK_SECRET>).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_WEBHOOK_SECRET=
OPEN_FINANCE_SYNC_INTERVAL_HOURS=1
OPEN_FINANCE_TRANSACTIONS_LOOKBACK_DAYS=90

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
